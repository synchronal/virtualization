#!/usr/bin/env bash

## Variables, set in .local/envrc
#
#  DEVELOPMENT_TEAM: the team whose identity bin/dev/sign signs the suites
#  with. Unset, it signs ad hoc.
#

source_up_if_exists

# default (committable) dev variables

source_env_if_exists .local/envrc

: "${DEVELOPMENT_TEAM:?env var must be set in .local/envrc}"
