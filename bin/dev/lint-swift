#!/usr/bin/env bash
#
# Lints the Swift sources with swift-format, strictly: a warning fails too.

set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

if ! command -v swift-format >/dev/null; then
  echo "bin/dev/lint-swift: swift-format isn't on PATH" >&2
  exit 1
fi

find . -name '*.swift' -not -path './target/*' -not -path '*/.build/*' -print0 |
  xargs -0 swift-format lint --strict --configuration .swift-format.json
