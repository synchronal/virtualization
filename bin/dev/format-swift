#!/usr/bin/env bash

format_swift() {
  find . -name '*.swift' -not -path './target/*' -not -path '*/.build/*' -exec swift-format format --configuration .swift-format.json -i {} \;
}

check_swift() {
  contents="$(find . -name '*.swift' -not -path './target/*' -not -path '*/.build/*' -exec cat \{\} \;)"
  formatted="$(find . -name '*.swift' -not -path './target/*' -not -path '*/.build/*' -exec swift-format format --configuration .swift-format.json \{\} \;)"

  if [[ "${contents}" == "${formatted}" ]]; then
    exit 0
  else
    echo "Swift files have not been properly formatted" >&2
    exit 1
  fi
}

case $1 in
  --all)
    format_swift
    ;;

  --check)
    check_swift
    ;;

  *)
    echo "unknown flag: '$1'" >&2
    echo "" >&2
    echo "USAGE" >&2
    echo "  $0 --all" >&2
    echo "  $0 --check" >&2
    exit 1
    ;;

esac
